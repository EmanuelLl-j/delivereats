# Crea estos valores en Vercel > Project > Settings > Environment Variables (Production).
# La ruta de login del portal llama desde el servidor de Vercel a este servicio NestJS.
# Debe ser la URL base de Render, sin /api/users ni /auth/login.
WEB_URL=https://delivereats-web.vercel.app
COOKIE_SECURE=true
# URL actual del servicio users-service desplegado en Render.
USERS_SERVICE_URL=https://delivereats-backend.onrender.com
# Configura estos valores cuando cada servicio esté desplegado. Usa su URL base,
# sin prefijos añadidos; las rutas concretas las agrega el portal.
ORDERS_SERVICE_URL=https://api.tudominio.com/api/orders
DRIVERS_SERVICE_URL=https://api.tudominio.com/api/drivers
NOTIFICATIONS_SERVICE_URL=https://api.tudominio.com/api/notifications
NEXT_PUBLIC_SOCKET_URL=https://api.tudominio.com
