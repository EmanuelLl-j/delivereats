# Copia de referencia. Ejecuta pnpm setup:local para generar secretos locales aleatorios.
# No existen cuentas precargadas. Crea tu primer administrador con pnpm admin:create.
NODE_ENV=development
JWT_SECRET=
JWT_REFRESH_SECRET=
INTERNAL_SERVICE_SECRET=
EVENTS_ENCRYPTION_KEY=
SHIPMENT_CODES_KEY=
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:8081,http://localhost:8082
POSTGRES_USER=delivereats
POSTGRES_PASSWORD=
USERS_DATABASE_URL=
ORDERS_DATABASE_URL=
DRIVERS_DATABASE_URL=
NOTIFICATIONS_DATABASE_URL=
RABBITMQ_USER=delivereats
RABBITMQ_PASSWORD=
RABBITMQ_URL=
REDIS_PASSWORD=
REDIS_URL=
# Archivos privados reales en disco SOLO local/test; producción exige s3.
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=/app/private-files
LOCAL_STORAGE_SIGNING_KEY=
PUBLIC_USERS_URL=http://localhost/api/users
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=DeliverEats Desarrollo <no-reply@example.test>
FIREBASE_SERVICE_ACCOUNT_JSON=
# LiveKit local opcional: docker compose --profile audio up -d livekit
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_INTERNAL_URL=http://livekit:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_NODE_IP=127.0.0.1
COMMUNICATION_GRACE_MINUTES=15
# Sin credenciales, Mercado Pago no se ofrece al cliente. No existe aprobación simulada.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
PUBLIC_API_URL=http://localhost/api/orders
WEB_URL=http://localhost
COOKIE_SECURE=false
NEXT_PUBLIC_SOCKET_URL=http://localhost
# Emulador Android. Para equipo físico usa la IP LAN del servidor.
EXPO_PUBLIC_API_URL=http://10.0.2.2/api
EXPO_PUBLIC_SOCKET_URL=http://10.0.2.2
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=
EXPO_EAS_PROJECT_ID=
GOOGLE_SERVICES_JSON=
