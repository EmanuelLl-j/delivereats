NODE_ENV=development

# Secrets de desarrollo: reemplázalos antes de cualquier despliegue compartido.
JWT_SECRET=development-only-change-me-access-secret
JWT_REFRESH_SECRET=development-only-change-me-refresh-secret
INTERNAL_SERVICE_SECRET=development-only-change-me-internal-secret
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:8081

POSTGRES_USER=delivereats
POSTGRES_PASSWORD=development-only-change-me-database
USERS_DATABASE_URL=postgresql://delivereats:development-only-change-me-database@postgres-users:5432/users_db?schema=public
ORDERS_DATABASE_URL=postgresql://delivereats:development-only-change-me-database@postgres-orders:5432/orders_db?schema=public
DRIVERS_DATABASE_URL=postgresql://delivereats:development-only-change-me-database@postgres-drivers:5432/drivers_db?schema=public
NOTIFICATIONS_DATABASE_URL=postgresql://delivereats:development-only-change-me-database@postgres-notifications:5432/notifications_db?schema=public

RABBITMQ_USER=delivereats
RABBITMQ_PASSWORD=development-only-change-me-rabbitmq
RABBITMQ_URL=amqp://delivereats:development-only-change-me-rabbitmq@rabbitmq:5672
RABBITMQ_ENABLED=true
REDIS_URL=redis://redis:6379

PAYMENTS_MODE=mock
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_SANDBOX=true

MAPS_PROVIDER=mock
GOOGLE_MAPS_API_KEY=

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=DeliverEats <no-reply@delivereats.local>

PUSH_PROVIDER=mock
FIREBASE_SERVICE_ACCOUNT_JSON=
SMS_PROVIDER=mock

PUBLIC_API_URL=http://localhost/api/orders
WEB_URL=http://localhost:3000
NEXT_PUBLIC_SOCKET_URL=http://localhost
EXPO_PUBLIC_API_URL=http://localhost/api
EXPO_PUBLIC_SOCKET_URL=http://localhost
