generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model EventOutbox {
  id            String    @id @db.Uuid
  name          String
  payload       String
  correlationId String
  attempts      Int       @default(0)
  lastError     String?
  createdAt     DateTime  @default(now())
  publishedAt   DateTime?

  @@index([publishedAt, createdAt])
  @@map("event_outbox")
}

enum MerchantCategory {
  RESTAURANT
  SUPERMARKET
  PHARMACY
  EXPRESS
}

enum OrderStatus {
  REQUIRES_REVIEW
  PENDING
  CONFIRMED
  SEARCHING_DRIVER
  ASSIGNED
  PREPARING
  READY_FOR_PICKUP
  PICKING_UP
  ON_THE_WAY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  YAPE_MANUAL
  PLIN_MANUAL
  MERCADO_PAGO
  YAPE
  PLIN
  CASH
  CARD
}

enum PaymentStatus {
  PAYMENT_PENDING_VERIFICATION
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  REFUNDED
  PAID
}

enum PromotionType {
  PERCENTAGE
  FIXED
  FREE_DELIVERY
}

enum PaymentProvider {
  MANUAL
  CASH
  MOCK
  MERCADO_PAGO
}

model Merchant {
  id                  String           @id @default(uuid()) @db.Uuid
  ownerUserId         String           @db.Uuid
  name                String
  description         String
  category            MerchantCategory
  ruc                 String           @unique
  phone               String
  email               String
  logoUrl             String?
  coverUrl            String?
  address             String
  latitude            Decimal          @db.Decimal(10, 7)
  longitude           Decimal          @db.Decimal(10, 7)
  rating              Decimal          @default(0) @db.Decimal(3, 2)
  deliveryEstimateMin Int
  deliveryEstimateMax Int
  isOpen              Boolean          @default(true)
  isActive            Boolean          @default(false)
  applicationStatus   ApplicationStatus @default(PENDING)
  applicationDocuments Json?
  businessHours       Json?
  reviewReason        String?
  reviewedBy          String?           @db.Uuid
  reviewedAt          DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  categories          Category[]
  products            Product[]
  cartItems           CartItem[]
  subOrders           SubOrder[]

  @@index([category, isActive, isOpen])
  @@index([ownerUserId])
  @@map("merchants")
}

model Category {
  id         String    @id @default(uuid()) @db.Uuid
  merchantId String    @db.Uuid
  name       String
  sortOrder  Int       @default(0)
  isActive   Boolean   @default(true)
  merchant   Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  products   Product[]

  @@unique([merchantId, name])
  @@map("categories")
}

model Product {
  id          String      @id @default(uuid()) @db.Uuid
  merchantId  String      @db.Uuid
  categoryId  String      @db.Uuid
  name        String
  description String
  price       Decimal     @db.Decimal(10, 2)
  imageUrl    String?
  isAvailable Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  merchant    Merchant    @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  category    Category    @relation(fields: [categoryId], references: [id])
  cartItems   CartItem[]
  orderItems  OrderItem[]

  @@index([merchantId, isAvailable])
  @@map("products")
}

model Cart {
  id         String     @id @default(uuid()) @db.Uuid
  customerId String     @unique @db.Uuid
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  items      CartItem[]

  @@map("carts")
}

model CartItem {
  id         String   @id @default(uuid()) @db.Uuid
  cartId     String   @db.Uuid
  productId  String   @db.Uuid
  merchantId String   @db.Uuid
  quantity   Int
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  cart       Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id])
  merchant   Merchant @relation(fields: [merchantId], references: [id])

  @@unique([cartId, productId])
  @@map("cart_items")
}

model Order {
  id                    String         @id @default(uuid()) @db.Uuid
  orderNumber           String         @unique
  customerId            String         @db.Uuid
  deliveryAddressId     String?        @db.Uuid
  type                  OrderType      @default(MARKETPLACE)
  version               Int            @default(0)
  completedAt           DateTime?
  cancelledAt           DateTime?
  deliveryAddress       String
  deliveryLatitude      Decimal        @db.Decimal(10, 7)
  deliveryLongitude     Decimal        @db.Decimal(10, 7)
  status                OrderStatus    @default(PENDING)
  subtotal              Decimal        @db.Decimal(10, 2)
  deliveryFee           Decimal        @db.Decimal(10, 2)
  serviceFee            Decimal        @db.Decimal(10, 2)
  discount              Decimal        @db.Decimal(10, 2)
  total                 Decimal        @db.Decimal(10, 2)
  paymentMethod         PaymentMethod
  paymentStatus         PaymentStatus  @default(PENDING)
  promoCode             String?
  assignedDriverId      String?        @db.Uuid
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  subOrders             SubOrder[]
  payments              PaymentIntent[]
  ratings               Rating[]
  statusHistory         OrderStatusHistory[]
  shipment              PersonalShipmentDetails?
  refunds               Refund[]

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([assignedDriverId])
  @@map("orders")
}

model SubOrder {
  id             String      @id @default(uuid()) @db.Uuid
  orderId        String      @db.Uuid
  merchantId     String      @db.Uuid
  status         OrderStatus @default(PENDING)
  subtotal       Decimal     @db.Decimal(10, 2)
  pickupSequence Int
  pickedUpAt     DateTime?
  acceptedAt     DateTime?
  preparingAt    DateTime?
  readyAt        DateTime?
  rejectionReason String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  order          Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  merchant       Merchant    @relation(fields: [merchantId], references: [id])
  items          OrderItem[]

  @@unique([orderId, merchantId])
  @@index([merchantId, status])
  @@map("sub_orders")
}

model OrderItem {
  id          String   @id @default(uuid()) @db.Uuid
  subOrderId  String   @db.Uuid
  productId   String   @db.Uuid
  productName String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2)
  subtotal    Decimal  @db.Decimal(10, 2)
  notes       String?
  subOrder    SubOrder @relation(fields: [subOrderId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Promotion {
  id              String        @id @default(uuid()) @db.Uuid
  code            String        @unique
  type            PromotionType
  value           Decimal       @db.Decimal(10, 2)
  minimumAmount   Decimal       @default(0) @db.Decimal(10, 2)
  maximumDiscount Decimal?      @db.Decimal(10, 2)
  startsAt        DateTime
  expiresAt       DateTime
  usageLimit      Int?
  usageCount      Int           @default(0)
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([isActive, startsAt, expiresAt])
  @@map("promotions")
}

model PaymentIntent {
  id                String          @id @default(uuid()) @db.Uuid
  orderId           String          @db.Uuid
  provider          PaymentProvider
  method            PaymentMethod
  status            PaymentStatus   @default(PENDING)
  amount            Decimal         @db.Decimal(10, 2)
  currency          String          @default("PEN")
  externalId        String?
  providerReference String?
  operationCode     String?
  evidenceFileId    String?         @db.Uuid
  reviewReason      String?
  reviewedBy        String?         @db.Uuid
  providerPaymentId String?         @unique
  sandboxPayload    Json?
  verifiedAt        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, status])
  @@index([externalId])
  @@map("payment_intents")
}

enum OrderType {
  MARKETPLACE
  PERSONAL_SHIPMENT
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ItemPolicyStatus {
  ALLOWED
  RESTRICTED
  PROHIBITED
}

enum ShipmentReviewStatus {
  NOT_REQUIRED
  REQUIRES_REVIEW
  APPROVED
  REJECTED
  INVESTIGATION
}

model ItemPolicy {
  id          String           @id @default(uuid()) @db.Uuid
  category    String           @unique
  description String
  status      ItemPolicyStatus
  version     Int              @default(1)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  revisions   ItemPolicyRevision[]

  @@map("item_policies")
}

model ItemPolicyRevision {
  id          String           @id @default(uuid()) @db.Uuid
  policyId    String           @db.Uuid
  version     Int
  description String
  status      ItemPolicyStatus
  isActive    Boolean
  actorUserId String           @db.Uuid
  createdAt   DateTime         @default(now())
  policy      ItemPolicy       @relation(fields: [policyId], references: [id])

  @@unique([policyId, version])
  @@map("item_policy_revisions")
}

model LogisticsConfig {
  vehicleType   String  @id
  maxWeightKg   Decimal @db.Decimal(8, 2)
  maxLengthCm   Decimal @db.Decimal(8, 2)
  maxWidthCm    Decimal @db.Decimal(8, 2)
  maxHeightCm   Decimal @db.Decimal(8, 2)
  baseFee       Decimal @db.Decimal(10, 2)
  perKmFee      Decimal @db.Decimal(10, 2)
  perKgFee      Decimal @db.Decimal(10, 2)
  perLiterFee   Decimal @db.Decimal(10, 4)
  serviceFee    Decimal @db.Decimal(10, 2)
  fragileFee    Decimal @db.Decimal(10, 2)
  maxDistanceKm Decimal @db.Decimal(8, 2)
  cashAllowed   Boolean @default(true)
  isActive      Boolean @default(true)
  version       Int     @default(1)
  updatedAt     DateTime @updatedAt

  @@map("logistics_configs")
}

model ShipmentQuote {
  id          String   @id @default(uuid()) @db.Uuid
  customerId  String   @db.Uuid
  input       Json
  breakdown   Json
  fingerprint String
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([customerId, expiresAt])
  @@map("shipment_quotes")
}

model PersonalShipmentDetails {
  orderId                  String   @id @db.Uuid
  quoteId                  String   @unique @db.Uuid
  pickupAddress            String
  pickupReference          String?
  pickupLatitude           Decimal  @db.Decimal(10, 7)
  pickupLongitude          Decimal  @db.Decimal(10, 7)
  dropoffAddress           String
  dropoffReference         String?
  dropoffLatitude          Decimal  @db.Decimal(10, 7)
  dropoffLongitude         Decimal  @db.Decimal(10, 7)
  recipientName            String
  packageCategory          String
  contentDescription       String
  weightKg                 Decimal  @db.Decimal(8, 2)
  lengthCm                 Decimal  @db.Decimal(8, 2)
  widthCm                  Decimal  @db.Decimal(8, 2)
  heightCm                 Decimal  @db.Decimal(8, 2)
  declaredValue            Decimal  @db.Decimal(10, 2)
  fragile                  Boolean
  packageImageUrl          String?
  vehicleType              String
  pickupVerificationCode   String
  deliveryVerificationCode String
  verificationAttempts     Int      @default(0)
  verificationLockedUntil  DateTime?
  pickedUpAt               DateTime?
  deliveredAt              DateTime?
  pickupEvidenceFileId      String?  @db.Uuid
  deliveryEvidenceFileId    String?  @db.Uuid
  restrictionStatus        ItemPolicyStatus
  reviewStatus             ShipmentReviewStatus
  reviewReason             String?
  reviewedBy               String?  @db.Uuid
  reviewedAt               DateTime?
  declarationEvidence      Json
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  order                    Order    @relation(fields: [orderId], references: [id])

  @@index([reviewStatus, createdAt])
  @@map("personal_shipment_details")
}

model PaymentConfiguration {
  method       String   @id
  enabled      Boolean  @default(false)
  accountLabel String?
  instructions String?
  qrImageUrl   String?
  updatedAt    DateTime @updatedAt

  @@map("payment_configurations")
}

model Refund {
  id                String   @id @default(uuid()) @db.Uuid
  orderId           String   @db.Uuid
  paymentIntentId   String   @db.Uuid
  amount            Decimal  @db.Decimal(10, 2)
  reason            String
  status            String   @default("REQUESTED")
  requestedBy       String   @db.Uuid
  reviewedBy        String?  @db.Uuid
  providerReference String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  order             Order    @relation(fields: [orderId], references: [id])

  @@index([orderId, status])
  @@map("refunds")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @db.Uuid
  action      String
  entity      String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([entity, entityId])
  @@map("audit_logs")
}

model OrderStatusHistory {
  id          String      @id @default(uuid()) @db.Uuid
  orderId     String      @db.Uuid
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  actorUserId String?     @db.Uuid
  metadata    Json?
  createdAt   DateTime    @default(now())
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model Rating {
  id         String   @id @default(uuid()) @db.Uuid
  orderId    String   @db.Uuid
  customerId String   @db.Uuid
  driverId   String?  @db.Uuid
  score      Int
  comment    String?
  createdAt  DateTime @default(now())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, customerId])
  @@map("ratings")
}

model OrderSequence {
  year      Int      @id
  value     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("order_sequences")
}
