{
  "info": {
    "_postman_id": "7b3e40f4-cb88-4f86-a21d-delivereats01",
    "name": "DeliverEats Ayacucho",
    "description": "Solicitudes manuales contra tu entorno. Completa identificadores obtenidos de registros reales y credenciales en Postman Vault; no exportes tokens ni contraseñas. No contiene cuentas precargadas ni aprobación simulada de pagos. No ejecutar toda la colección automáticamente.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost"
    },
    {
      "key": "customerToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "driverToken",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "paymentId",
      "value": ""
    },
    {
      "key": "customerEmail",
      "value": ""
    },
    {
      "key": "adminEmail",
      "value": ""
    },
    {
      "key": "driverEmail",
      "value": ""
    },
    {
      "key": "merchantId",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "deliveryAddressId",
      "value": ""
    },
    {
      "key": "deliveryAddress",
      "value": ""
    },
    {
      "key": "deliveryLatitude",
      "value": ""
    },
    {
      "key": "deliveryLongitude",
      "value": ""
    },
    {
      "key": "expectedTotal",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Login cliente",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) pm.collectionVariables.set('customerToken', pm.response.json().accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{vault:customerPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/users/auth/login"
          }
        },
        {
          "name": "Login admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) pm.collectionVariables.set('adminToken', pm.response.json().accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{vault:adminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/users/auth/login"
          }
        },
        {
          "name": "Login driver",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) pm.collectionVariables.set('driverToken', pm.response.json().accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{driverEmail}}\",\n  \"password\": \"{{vault:driverPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/users/auth/login"
          }
        }
      ]
    },
    {
      "name": "Catálogo y carrito",
      "item": [
        {
          "name": "Listar comercios",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/orders/merchants"
          }
        },
        {
          "name": "Detalle del comercio seleccionado",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/orders/merchants/{{merchantId}}"
          }
        },
        {
          "name": "Agregar producto seleccionado",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 1\n}"
            },
            "url": "{{baseUrl}}/api/orders/cart/items"
          }
        },
        {
          "name": "Ver carrito multi-negocio",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/orders/cart"
          }
        },
        {
          "name": "Cotizar antes de confirmar",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code < 300) pm.collectionVariables.set('expectedTotal', pm.response.json().total);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deliveryAddressId\": \"{{deliveryAddressId}}\",\n  \"deliveryAddress\": \"{{deliveryAddress}}\",\n  \"deliveryLatitude\": {{deliveryLatitude}},\n  \"deliveryLongitude\": {{deliveryLongitude}},\n  \"paymentMethod\": \"CASH\"\n}"
            },
            "url": "{{baseUrl}}/api/orders/cart/quote"
          }
        },
        {
          "name": "Checkout CASH con total previamente cotizado",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code < 300) { const body = pm.response.json(); pm.collectionVariables.set('orderId', body.order.id); if (body.payment?.id) pm.collectionVariables.set('paymentId', body.payment.id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deliveryAddressId\": \"{{deliveryAddressId}}\",\n  \"deliveryAddress\": \"{{deliveryAddress}}\",\n  \"deliveryLatitude\": {{deliveryLatitude}},\n  \"deliveryLongitude\": {{deliveryLongitude}},\n  \"paymentMethod\": \"CASH\",\n  \"expectedTotal\": {{expectedTotal}}\n}"
            },
            "url": "{{baseUrl}}/api/orders/cart/checkout"
          }
        }
      ]
    },
    {
      "name": "Operación",
      "item": [
        {
          "name": "Oferta activa driver",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{driverToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/drivers/drivers/me/offers/active"
          }
        },
        {
          "name": "Detalle pedido",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/orders/orders/{{orderId}}"
          }
        },
        {
          "name": "Tracking REST",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/drivers/tracking/orders/{{orderId}}/location"
          }
        }
      ]
    },
    {
      "name": "Administración",
      "item": [
        {
          "name": "Dashboard metrics",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/orders/admin/metrics"
          }
        },
        {
          "name": "Usuarios",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/users/users"
          }
        },
        {
          "name": "Repartidores",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/drivers/admin/drivers"
          }
        },
        {
          "name": "Promociones",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/orders/promotions"
          }
        },
        {
          "name": "Auditoría",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/users/users/audit"
          }
        }
      ]
    },
    {
      "name": "Readiness",
      "item": [
        {
          "name": "Users",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/users/ready"
          }
        },
        {
          "name": "Orders",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/orders/ready"
          }
        },
        {
          "name": "Drivers",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/drivers/ready"
          }
        },
        {
          "name": "Notifications",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/notifications/ready"
          }
        }
      ]
    }
  ]
}
